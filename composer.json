{
  "name": "cinqdev/jennylind-sage",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "Jenny Lind Inn WordPress theme (Sage 11)",
  "homepage": "https://jennylindhastings.co.uk",
  "authors": [
    {
      "name": "CINQ",
      "homepage": "https://cinq.co.uk"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
